<?xml version="1.0" encoding="utf-8"?>
<framework>
    <if split_keyboard_handedness_ja="right|left">
        <key_mapping state="EMOJI_AVAILABLE">
            <mapping key_id="@id/id_0x7f0b12cc" view_id="@id/key_pos_switch_to_symbol" />
        </key_mapping>
        <if expressions="policy_transparency">
            <key_mapping>
                <mapping key_id="@id/id_0x7f0b1b77" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/id_0x7f0b12ca" view_id="@id/key_pos_switch_to_emoticon" />
            </key_mapping>
        </if>
        <else_if expressions="hidden">
            <key_mapping>
                <mapping key_id="@id/id_0x7f0b0d52" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/id_0x7f0b0d52" view_id="@id/key_pos_switch_to_emoticon" />
                <mapping key_id="@id/id_0x7f0b12ce" view_id="@id/key_pos_switch_to_symbol" />
            </key_mapping>
        </else_if>
        <else>
            <key_mapping>
                <mapping key_id="@id/id_0x7f0b1b76" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/id_0x7f0b12c9" view_id="@id/key_pos_switch_to_emoticon" />
            </key_mapping>
            <key_mapping state="EMOJI_AVAILABLE">
                <mapping key_id="@id/id_0x7f0b1b73" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/id_0x7f0b12c8" view_id="@id/key_pos_switch_to_emoticon" />
            </key_mapping>
        </else>
    </if>
</framework>
