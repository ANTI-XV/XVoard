<?xml version="1.0" encoding="utf-8"?>
<framework>
    <if device="tablet" device_size="large">
        <key_mapping state="SHOW_EMOJI_SWITCH_KEY">
            <if expressions="policy_transparency">
                <mapping key_id="@id/id_0x7f0b1b77" view_id="@id/key_pos_switch_to_smiley" />
            </if>
            <else>
                <mapping key_id="@id/id_0x7f0b1b73" view_id="@id/key_pos_switch_to_smiley" />
            </else>
        </key_mapping>
    </if>
    <else>
